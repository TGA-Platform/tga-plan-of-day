{
  "redirects": [
    { "source": "/guide", "destination": "/guide.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|guide).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-roster-refresh",
      "schedule": "*/5 * * * *"
    }
  ]
}
